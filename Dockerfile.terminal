ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /home/player

# Install useful terminal tools for either Debian/Ubuntu or Alpine base images.
RUN if command -v apt-get >/dev/null 2>&1; then \
        apt-get update && \
        apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        curl \
        findutils \
        gawk \
        git \
        grep \
        iputils-ping \
        less \
        nano \
        procps \
        sed \
    sudo \
        util-linux \
        vim-tiny \
        wget && \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache \
        bash \
        ca-certificates \
        coreutils \
        curl \
        findutils \
        gawk \
        git \
        sudo \
        grep \
        iputils \
        less \
        nano \
        procps \
        sed \
        vim \
        wget; \
    else \
        echo "Unsupported base image package manager" && exit 1; \
    fi

RUN if command -v useradd >/dev/null 2>&1; then \
        useradd -m -d /home/player -s /bin/bash terminal || true; \
    elif command -v adduser >/dev/null 2>&1; then \
        adduser -D -h /home/player -s /bin/bash terminal || true; \
    fi

RUN mkdir -p /home/player/files /setup && chown -R terminal:terminal /home/player || true

RUN mkdir -p /etc/sudoers.d && \
    printf '%s\n' 'Defaults:terminal secure_path="/usr/local/restricted/bin"' > /etc/sudoers.d/terminal && \
    printf '%s\n' 'Cmnd_Alias SAFE = /usr/local/restricted/bin/ls, /usr/local/restricted/bin/cat, /usr/local/restricted/bin/pwd, /usr/local/restricted/bin/whoami, /usr/local/restricted/bin/uname, /usr/local/restricted/bin/echo, /usr/local/restricted/bin/clear, /usr/local/restricted/bin/help' >> /etc/sudoers.d/terminal && \
    printf '%s\n' 'terminal ALL=(ALL) NOPASSWD: SAFE' >> /etc/sudoers.d/terminal && \
    chmod 0440 /etc/sudoers.d/terminal

COPY scripts/restricted-entrypoint.sh /usr/local/bin/restricted-entrypoint.sh
COPY setup/generate_files.sh /setup/generate_files.sh
RUN chmod 0755 /usr/local/bin/restricted-entrypoint.sh
RUN chmod 0755 /setup/generate_files.sh

# Aggressively remove docker-compose and docker binaries
RUN rm -f /usr/bin/docker /usr/bin/docker-compose /usr/local/bin/docker /usr/local/bin/docker-compose /bin/docker /usr/sbin/docker 2>/dev/null || true

# Remove bash completion scripts to prevent any inference or help display
RUN rm -rf /etc/bash_completion* /usr/share/bash-completion* || true
RUN rm -rf /etc/profile.d/* || true

ENTRYPOINT ["/usr/local/bin/restricted-entrypoint.sh"]